otelcol.receiver.otlp "meli_order_book" {
  grpc { endpoint = "0.0.0.0:4317" }
  http { endpoint = "0.0.0.0:4318" }
  output {
    metrics = [otelcol.exporter.prometheus.metrics.input]
    traces = [otelcol.exporter.otlp.tempo.input]
    logs = [otelcol.exporter.loki.logs.input]
  }
}

// OTLP metrics use Prometheus remote-write. /metrics remains the pull source.
otelcol.exporter.prometheus "metrics" {
  forward_to = [prometheus.remote_write.otlp.receiver]
}

prometheus.remote_write "otlp" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls { insecure = true }
  }
}

otelcol.exporter.loki "logs" {
  forward_to = [loki.write.logs.receiver]
}

loki.write "logs" {
  endpoint { url = "http://loki:3100/loki/api/v1/push" }
}
